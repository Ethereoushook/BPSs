function ESPLib.GetCharacter(target)
    if typeof(target) == "Instance" then
        if target:IsA("Player") then
            return target.Character
        elseif target:IsA("Model") then
            return target
        end
    end
    return nil
end

function ESPLib.GetRootPart(character)
    if not character then return nil end
    return character:FindFirstChild("HumanoidRootPart")
        or character:FindFirstChild("RootPart")
        or character:FindFirstChild("Torso")
        or character:FindFirstChild("UpperTorso")
        or character.PrimaryPart
        or character:FindFirstChildWhichIsA("BasePart")
end

function ESPLib.GetHealth(character)
    if not character then return 0, 100 end

    local attrHp = character:GetAttribute("Health") or character:GetAttribute("HP")
    local attrMaxHp = character:GetAttribute("MaxHealth") or character:GetAttribute("MaxHP")
    if typeof(attrHp) == "number" then
        return attrHp, (typeof(attrMaxHp) == "number" and attrMaxHp > 0) and attrMaxHp or 100
    end

    local hum = character:FindFirstChild("Humanoid") or character:FindFirstChildOfClass("Humanoid")
    if hum then
        local hp = hum.Health
        local maxHp = hum.MaxHealth

        if hp ~= hp or hp >= math.huge then
            return 100, 100
        end
        if maxHp ~= maxHp or maxHp >= math.huge or maxHp <= 0 then
            return hp, (hp > 0 and hp or 100)
        end

        return hp, maxHp
    end

    return 100, 100
end

